<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>MechSuit</AssemblyName>
    <RootNamespace>MechMod</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- Point this at your Blade & Sorcery install, or pass -p:GameDir=... on the command line. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Blade &amp; Sorcery</GameDir>
    <ManagedDir>$(GameDir)\BladeAndSorcery_Data\Managed</ManagedDir>
    <ModOutputDir>$(MSBuildProjectDirectory)\..\..\Mod\MechSuit</ModOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ThunderRoad" HintPath="$(ManagedDir)\ThunderRoad.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
  </ItemGroup>

  <!-- Drop the built DLL next to manifest.json so the Mod/MechSuit folder is ready to copy into StreamingAssets/Mods. -->
  <Target Name="CopyToModFolder" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)" />
  </Target>

</Project>
